# The vendored upstream licences are copies, and `notices/upstream/README.md`
# says they are copied byte for byte. On Windows, Git's line-ending conversion
# would quietly make that untrue — the file checked out is not the file that was
# fetched, and an attribution that has been reformatted is exactly what vendoring
# these instead of rendering a template was meant to avoid.
notices/upstream/*.txt -text

# Modules a script under `scripts/` writes. Each says which in its first line
# (the JSON cannot, and its generator is `scripts/build-engine.mjs`), and
# `tests/generated.test.ts` holds this list to those lines. Marked so a review
# folds their diffs and language statistics leave them out.
src/core/docs/*.gen.ts linguist-generated=true
src/core/luneApi.ts linguist-generated=true
src/core/robloxData.ts linguist-generated=true
src/core/robloxEngine.json linguist-generated=true
src/core/robloxMembers.ts linguist-generated=true
src/core/robloxProperties.ts linguist-generated=true
src/core/licenceData.ts linguist-generated=true
src/core/themeData.ts linguist-generated=true
