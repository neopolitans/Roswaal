{
  "name": "roswaal",
  "version": "0.236.2",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "description": "Visual scripting for Roblox Luau and Lune Luau.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:themes && npm run build:licences && npm run build:web && npm run build:cli",
    "build:web": "tsc --noEmit && vite build",
    "build:binary": "node scripts/build-binary.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "roswaal": "node dist-cli/roswaal.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:themes": "tsx scripts/build-themes.mjs",
    "build:licences": "node scripts/build-licences.mjs",
    "build:roblox": "node scripts/build-roblox.mjs",
    "build:members": "tsx scripts/build-members.mjs",
    "build:properties": "tsx scripts/build-properties.mjs",
    "build:engine": "tsx scripts/build-engine.mjs",
    "build:icons": "node scripts/build-class-icons.mjs",
    "build:lune": "node scripts/build-lune.mjs",
    "build:docs": "tsx scripts/build-docs.mjs",
    "build:spec": "tsx scripts/build-spec.mjs",
    "build:policy": "tsx scripts/build-policy.mjs",
    "docs:reviews": "tsx scripts/docs-reviews.mjs",
    "docs:coverage": "tsx scripts/docs-coverage.mjs",
    "demo:lune": "tsx scripts/build-lune-demo.mjs",
    "demo:fold": "tsx scripts/fold-demo-layout.mjs",
    "dev:site": "vite --config vite.web.config.ts",
    "build:site": "tsc --noEmit && vite build --config vite.web.config.ts",
    "build:pages": "tsx scripts/build-pages.mjs",
    "build:social": "tsx scripts/build-social.mjs",
    "audit:graphs": "tsx scripts/audit-graphs.mts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "chokidar": "^5.0.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "bin": {
    "roswaal": "./bin/roswaal.mjs"
  }
}
