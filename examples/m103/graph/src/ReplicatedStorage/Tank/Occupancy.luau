function Occupancy.hide(character: Model, hull: BasePart): boolean
	-- First check if the restores table already has
	if restores[character] then
		return false
	end

	-- Check if there's a Humanoid and a HumaoidRootPart on the player character.
	local humanoid = (character:FindFirstChildWhichIsA("Humanoid") :: Humanoid?)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		return false
	end

	-- Create the initial "restore" table for the player
	local restore: { [any]: any } = {
		transparency = {},
		collide = {},
		query = {},
		walkSpeed = humanoid.WalkSpeed,
		jumpHeight = humanoid.JumpHeight,
		nameDisplay = humanoid.DisplayDistanceType,
		weld = nil,
	}

	--[[
		Go through all instances in the array and cache it's original state. Decals and Textures only have their initial transparency cached, while BaseParts also have their CanCollide and CanQuery state cached.

	]]
	for key, part: BasePart in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			local Cast = (part :: BasePart)
			restore.transparency[Cast] = Cast.Transparency
			restore.collide[Cast] = Cast.CanCollide
			restore.query[Cast] = Cast.CanQuery
			Cast.Transparency = 1
			Cast.CanCollide = false
			Cast.CanQuery = false

		-- Handle Decals and Textures here
		elseif part:IsA("Decal") or part:IsA("Texture") then
			restore.transparency[part] = part.Transparency
			part.Transparency = 1
		end
	end

	-- Handle Humanoid settings that can't be iterated over
	humanoid.WalkSpeed = 0
	humanoid.JumpHeight = 0
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	-- Create the binding weld here for the player to be connected to the hull.
	root.CFrame = hull.CFrame
	local weld: WeldConstraint = Instance.new("WeldConstraint")
	weld.Name = "TankOccupant"
	weld.Part0 = root
	weld.Part1 = hull
	weld.Parent = root

	-- Finish handling the character restore points and bind the new restore table to the global restores table.
	restore.weld = weld
	restores[character] = restore
	return true
end

function Occupancy.show(character: Model, exitAt: CFrame): ()
	local restore: { [any]: any } = restores[character]

	-- If a character restore can't be found, do nothing
	if not restore then
		return
	end

	-- Remove the Restore table for a character
	restores[character] = nil

	-- Destroy the weld
	if restores.weld then
		restores.weld:Destroy()
	end

	-- Reset all instance transparencies captured in the restore table.
	for instance: Instance, value: number in pairs(restores.transparency) do
		if instance.Parent then
			instance.Transparency = value
		end
	end

	-- Reset all BasePart CanCollides captured in the restore table.
	for part: BasePart, value: boolean in pairs(restores.collide) do
		if part.Parent then
			part.CanCollide = value
		end
	end

	-- Reset all BasePart CanQuerys captured in the restore table.
	for part: BasePart, value: boolean in pairs(restores.query) do
		if part.Parent then
			part.CanQuery = value
		end
	end

	-- Reset the Humanoid State
	local humanoid = (character:FindFirstChildWhichIsA("Humanoid") :: Humanoid?)
	if humanoid then
		humanoid.WalkSpeed = restore.walkSpeed
		humanoid.JumpHeight = restore.jumpHeight
		humanoid.DisplayDistanceType = restore.nameDisplay
	end

	-- Set the character's root back to the exit CFrame position.
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.CFrame = exitAt
	end
end

-- Is the given character currently riding in a tank?
function Occupancy.isHidden(character: Model): ()
	return restores[character] ~= nil
end

return Occupancy
