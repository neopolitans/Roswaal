local function readNumbers(container: Instance, name: string): ()
	local value = container:FindFirstChild(name)

	-- First check if the child exists
	if not value then
		error(container:GetFullName() .. " has no child called " .. name, 1)
	end

	-- Then check if it is a NumberValue
	if not value:IsA("NumberValue") then
		error(value:GetFullName() .. " is a " .. value.ClassName .. " not a NumberValue.", 1)
	end

	-- Return the NumberValue.Value property
	return value.Value
end

