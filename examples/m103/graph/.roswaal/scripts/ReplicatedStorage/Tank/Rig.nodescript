  "comments": [
    {
      "id": "337ed046-19e7-4a84-8495-6b6379d69d14",
      "x": 864,
      "y": 139,
      "w": 998,
      "h": 351,
      "text": "Get the main body models first.",
      "graph": "f827bd83-f29f-482f-abca-019949b28bfa"
    },
    {
      "id": "4c1f2db8-345b-446e-8d67-33d9a67e034d",
      "x": 1316,
      "y": 438,
      "w": 1298,
      "h": 467,
      "text": "If the expected class doesn't match that of the found child, error",
      "graph": "060f64e8-5751-45cb-a08d-185b79e0af90"
    },
    {
      "id": "5f619849-df48-4151-ac6c-49b5136b15c2",
      "x": 228,
      "y": 355,
      "w": 505.75,
      "h": 96,
      "text": "I did genuinely try this as a node graph, and it worked just fine but took five lines instead of the Luau expression it actually was in the native definition. Luau Expressions are useful for cases like this, where the branch is part of the return block!",
      "graph": "ebc4b7c0-7c3d-4496-a0a4-996c6d94bd33"
    },
    {
      "id": "7294e66f-a0cd-4a92-94c5-154334b3a432",
      "x": 1315,
      "y": 128,
      "w": 660.65,
      "h": 292.62,
      "text": "If the parent hasn't got a child matching the name, error",
      "graph": "060f64e8-5751-45cb-a08d-185b79e0af90"
    },
    {
      "id": "842c35db-1c21-460f-ba3b-6bda87811ea6",
      "x": -177,
      "y": 2655,
      "w": 441.53,
      "h": 96,
      "text": "We're using code expressions here because it translates better, with easier suggestions than doing it the node route, but both work just fine. I'd recommend beginners in Luau first get comfortable with Luau Expressions in cases like this *then* Custom Code blocks!",
      "color": "b0789c",
      "graph": "f827bd83-f29f-482f-abca-019949b28bfa"
    },
    {
      "id": "bb540628-5f02-4089-a758-8b9896f05f99",
      "x": 880,
      "y": 539,
      "w": 3516.33,
      "h": 413.81,
      "text": "Get all required BaseParts and Motor6Ds for the final dictionary.",
      "graph": "f827bd83-f29f-482f-abca-019949b28bfa"
    }
  ]
}
