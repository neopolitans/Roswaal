  "comments": [
    {
      "id": "5632e5e2-8351-414b-b44a-254287e772e8",
      "x": 1269,
      "y": 421,
      "w": 558,
      "h": 212,
      "text": "Defines restores table"
    },
    {
      "id": "5b8d1357-f57c-4e83-ad08-b145ce6c6f68",
      "x": 2347,
      "y": 1862,
      "w": 3824.67,
      "h": 974.55,
      "text": "Go through all instances in the array and cache it's original state. Decals and Textures only have their initial transparency cached, while BaseParts also have their CanCollide and CanQuery state cached.\n",
      "graph": "5ba2fcc4-c3fa-4c9c-a926-46000c9cc22f"
    },
    {
      "id": "60881935-67ee-4380-b288-2185d0dd6ee5",
      "x": 1725,
      "y": 1168,
      "w": 1004.38,
      "h": 234.9,
      "text": "First check if the restores table already has",
      "graph": "5ba2fcc4-c3fa-4c9c-a926-46000c9cc22f"
    },
    {
      "id": "69a8f24d-d8c2-4bc7-bcd1-d9f9a2c52dee",
      "x": 368,
      "y": 1846,
      "w": 1429,
      "h": 967,
      "text": "Create the initial \"restore\" table for the player",
      "graph": "5ba2fcc4-c3fa-4c9c-a926-46000c9cc22f"
    },
    {
      "id": "75d11c49-54c3-4e75-8129-106005abd4b3",
      "x": 1716,
      "y": 1425,
      "w": 2107,
      "h": 386,
      "text": "Check if there's a Humanoid and a HumaoidRootPart on the player character.",
      "graph": "5ba2fcc4-c3fa-4c9c-a926-46000c9cc22f"
    },
    {
      "id": "8a530344-32fb-427f-9c0c-c9b23914c0c2",
      "x": 3090,
      "y": 2916,
      "w": 2581.79,
      "h": 533.84,
      "text": "Create the binding weld here for the player to be connected to the hull.",
      "graph": "5ba2fcc4-c3fa-4c9c-a926-46000c9cc22f"
    },
    {
      "id": "ab2cff97-73bc-4d84-832b-ed2c9f4fe1e2",
      "x": 1557,
      "y": 3003,
      "w": 1487,
      "h": 375,
      "text": "Handle Humanoid settings that can't be iterated over",
      "graph": "5ba2fcc4-c3fa-4c9c-a926-46000c9cc22f"
    },
    {
      "id": "bc8895fa-1534-400e-bf9e-632e5f913b20",
      "x": 1272,
      "y": 72,
      "w": 1153,
      "h": 341,
      "text": "Defines"
    },
    {
