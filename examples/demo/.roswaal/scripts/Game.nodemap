{
  "schemaVersion": 1,
  "kind": "map",
  "id": "demo-game-map",
  "name": "roswaal-demo",
  "output": "default.project.json",
  "globIgnorePaths": [
    "**/*.spec.luau"
  ],
  "root": {
    "id": "root",
    "name": "DataModel",
    "className": "DataModel",
    "children": [
      {
        "id": "sss",
        "name": "ServerScriptService",
        "path": "src/ServerScriptService",
        "children": []
      },
      {
        "id": "rs",
        "name": "ReplicatedStorage",
        "path": "src/ReplicatedStorage",
        "children": []
      }
    ]
  }
}
